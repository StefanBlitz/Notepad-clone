<Window x:Class="NotepadClone.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About"
        Height="250"
        Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <TextBlock Text="Notepad Clone by Oiste Stefan Vlad"
                       FontSize="22"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

            <TextBlock Text="Version 1.0"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

            <TextBlock Text="Developed using WPF and MVVM"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <Button Content="OK"
                    Width="80"
                    HorizontalAlignment="Center"
                    Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>