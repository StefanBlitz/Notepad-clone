<Window x:Class="NotepadClone.Views.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NotepadClone.Views"
        mc:Ignorable="d"
        Height="220"
        Width="350"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="15">

        <TextBlock Text="Find:"/>
        <TextBox Text="{Binding SearchText}" Margin="0,5,0,10"/>

        <TextBlock Text="Replace:"/>
        <TextBox Text="{Binding ReplaceText}" Margin="0,5,0,10"/>

        <CheckBox Content="Search in all tabs"
                  IsChecked="{Binding SearchInAllTabs}"
                  Margin="0,5,0,10"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

            <Button Content="Find"
                    Width="70"
                    Margin="5"
                    Command="{Binding FindCommand}"/>

            <Button Content="Replace"
                    Width="70"
                    Margin="5"
                    Command="{Binding ReplaceCommand}"/>

            <Button Content="Replace All"
                    Width="90"
                    Margin="5"
                    Command="{Binding ReplaceAllCommand}"/>

        </StackPanel>

    </StackPanel>
</Window>
