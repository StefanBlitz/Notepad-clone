<Window x:Class="NotepadClone.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:NotepadClone.Helpers"
        Title="Editor"
        Height="600"
        Width="1000">

    <Window.Resources>
        <helpers:BoolToWidthConverter x:Key="BoolToWidthConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewFileCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseCommand}" />
        <KeyBinding Key="W" Modifiers="Control+Shift" Command="{Binding CloseAllCommand}" />
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ToggleExplorerCommand}" />
    </Window.InputBindings>

    <DockPanel>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem Header="New file"
                          InputGestureText="Ctrl+N"
                          Command="{Binding NewFileCommand}" />
                <MenuItem Header="Open..."
                          InputGestureText="Ctrl+O"
                          Command="{Binding OpenCommand}" />
                <Separator/>
                <MenuItem Header="Save"
                          InputGestureText="Ctrl+S"
                          Command="{Binding SaveCommand}" />
                <MenuItem Header="Save As"
                          InputGestureText="Ctrl+Shift+S"
                          Command="{Binding SaveAsCommand}" />
                <Separator/>
                <MenuItem Header="Close"
                          InputGestureText="Ctrl+W"
                          Command="{Binding CloseCommand}" />
                <MenuItem Header="Close All"
                          InputGestureText="Ctrl+Shift+W"
                          Command="{Binding CloseAllCommand}" />
            </MenuItem>

            <MenuItem Header="View">
                <MenuItem Header="Show Explorer"
                          IsCheckable="True"
                          IsChecked="{Binding IsExplorerVisible, Mode=OneWay}"
                          InputGestureText="Ctrl+E"
                          Command="{Binding ToggleExplorerCommand}"/>
            </MenuItem>

            <MenuItem Header="Search">
                <MenuItem Header="Find / Replace..."
              Click="OpenSearchWindow"/>
            </MenuItem>

            <MenuItem Header="Help">
                <MenuItem Header="About"
                          Command="{Binding ShowAboutCommand}"/>
            </MenuItem>
        </Menu>

        <ToolBar DockPanel.Dock="Top">
            <Button Content="New" Command="{Binding NewFileCommand}" />
            <Button Content="Open" Command="{Binding OpenCommand}" />
            <Button Content="Save" Command="{Binding SaveCommand}" />
        </ToolBar>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock>
                    <Run Text="Ln "/>
                    <Run Text="{Binding SelectedDocument.Line}"/>
                    <Run Text=", Col "/>
                    <Run Text="{Binding SelectedDocument.Column}"/>
                    <Run Text=" | Chars "/>
                    <Run Text="{Binding SelectedDocument.CharacterCount}"/>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding IsExplorerVisible, Converter={StaticResource BoolToWidthConverter}}"/>
                <ColumnDefinition MinWidth="150"/>
            </Grid.ColumnDefinitions>

            <TreeView x:Name="FolderTree"
                      Grid.Column="0"
                      Visibility="{Binding IsExplorerVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                      ItemsSource="{Binding RootItems}"
                      MouseDoubleClick="TreeView_MouseDoubleClick">

                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <EventSetter Event="Expanded"
                                     Handler="TreeViewItem_Expanded"/>
                        <EventSetter Event="PreviewMouseRightButtonDown"
                                     Handler="TreeViewItem_PreviewMouseRightButtonDown"/>
                    </Style>
                </TreeView.ItemContainerStyle>

                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding Name}" />
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>

            </TreeView>


            <TabControl Grid.Column="1"
                        ItemsSource="{Binding Documents}"
                        SelectedItem="{Binding SelectedDocument}"
                        SelectionChanged="TabControl_SelectionChanged">

                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <EventSetter Event="PreviewMouseDown"
                                     Handler="TabItem_PreviewMouseDown"/>
                    </Style>
                </TabControl.ItemContainerStyle>

                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayTitle}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,0"/>
                            <Button Content="x"
                                    Width="16"
                                    Height="16"
                                    Padding="0"
                                    Command="{Binding DataContext.CloseCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>

                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <TextBox Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                                 helpers:TextBoxBehavior.BoundSelectionStart="{Binding SelectionStart}"
                                 helpers:TextBoxBehavior.BoundSelectionLength="{Binding SelectionLength}"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 FontSize="14"
                                 Padding="10"
                                 TextChanged="Editor_TextChanged"
                                 SelectionChanged="Editor_SelectionChanged"/>
                    </DataTemplate>
                </TabControl.ContentTemplate>

            </TabControl>

        </Grid>

    </DockPanel>
</Window>