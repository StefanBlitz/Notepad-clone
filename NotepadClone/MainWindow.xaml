<Window x:Class="NotepadClone.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Editor" Height="600" Width="1000">

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewFileCommand}" />
        <KeyBinding Key="N" Modifiers="Control+Shift" Command="{Binding CreateFileInFolderCommand}" CommandParameter="{Binding SelectedItem, ElementName=FolderTree}" />
        <KeyBinding Key="N" Modifiers="Control+Alt" Command="{Binding CreateFolderInFolderCommand}" CommandParameter="{Binding SelectedItem, ElementName=FolderTree}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseCommand}" />
        <KeyBinding Key="W" Modifiers="Control+Shift" Command="{Binding CloseAllCommand}" />
        <KeyBinding Key="C" Modifiers="Control+Shift" Command="{Binding CopyPathCommand}" CommandParameter="{Binding SelectedItem, ElementName=FolderTree}" />
        <KeyBinding Key="F" Modifiers="Control+Shift" Command="{Binding CopyFolderCommand}" CommandParameter="{Binding SelectedItem, ElementName=FolderTree}" />
        <KeyBinding Key="V" Modifiers="Control+Shift" Command="{Binding PasteFolderCommand}" CommandParameter="{Binding SelectedItem, ElementName=FolderTree}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteItemCommand}" CommandParameter="{Binding SelectedItem, ElementName=FolderTree}" />
    </Window.InputBindings>

    <DockPanel>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem Header="New file"
                          InputGestureText="Ctrl+N"
                          Command="{Binding NewFileCommand}" />
                <MenuItem Header="Open..."
                          InputGestureText="Ctrl+O"
                          Command="{Binding OpenCommand}" />
                <Separator/>
                <MenuItem Header="Save"
                          InputGestureText="Ctrl+S"
                          Command="{Binding SaveCommand}" />
                <MenuItem Header="Save As"
                          InputGestureText="Ctrl+Shift+S"
                          Command="{Binding SaveAsCommand}" />
                <Separator/>
                <MenuItem Header="Close"
                          InputGestureText="Ctrl+W"
                          Command="{Binding CloseCommand}" />
                <MenuItem Header="Close All"
                          InputGestureText="Ctrl+Shift+W"
                          Command="{Binding CloseAllCommand}" />
            </MenuItem>
        </Menu>

        <ToolBar DockPanel.Dock="Top">
            <Button Content="New" Command="{Binding NewFileCommand}" />
            <Button Content="Open" Command="{Binding OpenCommand}" />
            <Button Content="Save" Command="{Binding SaveCommand}" />
        </ToolBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <TreeView x:Name="FolderTree"
          Grid.Column="0"
          ItemsSource="{Binding RootItems}"
          MouseDoubleClick="TreeView_MouseDoubleClick">

                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <EventSetter Event="Expanded"
                         Handler="TreeViewItem_Expanded"/>
                        <EventSetter Event="PreviewMouseRightButtonDown"
                         Handler="TreeViewItem_PreviewMouseRightButtonDown"/>
                    </Style>
                </TreeView.ItemContainerStyle>

                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding Name}" />
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>

            </TreeView>

            <TabControl Grid.Column="1"
                        ItemsSource="{Binding Documents}"
                        SelectedItem="{Binding SelectedDocument}">

                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <EventSetter Event="PreviewMouseDown"
                                     Handler="TabItem_PreviewMouseDown"/>
                    </Style>
                </TabControl.ItemContainerStyle>

                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayTitle}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,0"/>
                            <Button Content="x"
                                    Width="16"
                                    Height="16"
                                    Padding="0"
                                    Command="{Binding DataContext.CloseCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>

                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <TextBox Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"/>
                    </DataTemplate>
                </TabControl.ContentTemplate>

            </TabControl>

        </Grid>

    </DockPanel>
</Window>